   "source": [
    "\"\"\"\n",
    "cell 6: 추론 준비 및 이미지 처리 함수 \n",
    "\"\"\"\n",
    "# tokenizer와 processor\n",
    "from transformers import AutoProcessor, AutoTokenizer\n",
    "from megatron.inference.text_generation.api import generate_and_post_process\n",
    "from megatron.training import get_args, print_rank_0\n",
    "\n",
    "TEST_IMAGE_PATH = \"/workspace/Megatron-LM/test_img01.png\"\n",
    "USER_PROMPT = \"Describe this image in detail.\"\n",
    "\n",
    "try:\n",
    "    image_processor = AutoProcessor.from_pretrained(TOKENIZER_PATH, trust_remote_code=True)\n",
    "    tokenizer = AutoTokenizer.from_pretrained(TOKENIZER_PATH, trust_remote_code=True)\n",
    "except Exception as e:\n",
    "    print(f\"⚠️ 모델 로드 실패: {e}\")\n",
    "    traceback.print_exc()\n",
    "    raise e\n",
    "\n",
    "# Qwen/DeepSeek 계열 VLM에서 자주 쓰이는 프롬프트 포맷 (모델 학습 방식에 따라 다를 수 있음)\n",
    "PROMPT_TEXT = f\"<image>\\nUser: {USER_PROMPT}\\nAssistant:\"\n",
    "\n",
    "args = get_args()\n",
    "\n",
    "def image_process(image_path: str, image_processor, args):\n",
    "    try:\n",
    "        print_rank_0(f\"Loading image from {image_path}...\")\n",
    "        raw_image = Image.open(image_path).convert(\"RGB\")\n",
    "\n",
    "        # Image Processor를 통해 텐서 변환 (dict 형태 반환: {'pixel_values': ...})        \n",
    "        image_inputs = image_processor.image_processor(images=raw_image, return_tensors=\"pt\")\n",
    "        \n",
    "        print_rank_0(f\"Processor Output Keys: {image_inputs.keys()}\")\n",
    "        \n",
    "        # 모델의 dtype(float16 또는 bfloat16)에 맞춰 캐스팅 및 GPU 이동    \n",
    "        dtype = args.params_dtype \n",
    "        \n",
    "        # pixel_values 추출 및 디바이스 이동\n",
    "        if 'pixel_values' in image_inputs:\n",
    "            image_tensor = image_inputs['pixel_values'].cuda().to(dtype)\n",
    "        else:\n",
    "            # 혹시 키 값이 다를 경우를 대비해 첫 번째 value를 사용\n",
    "            image_tensor = list(image_inputs.values())[0].cuda().to(dtype)\n",
    "        \n",
    "        if 'image_grid_thw' in image_inputs:\n",
    "            image_grid_thw = image_inputs['image_grid_thw'].cuda().to(dtype)\n",
    "            # 만약 모델 forward가 이 grid 정보를 필요로 한다면, 나중에 forward_step 함수에도 넣어줘야 합니다.\n",
    "            print_rank_0(f\"Image Grid Shape: {image_grid_thw.shape}\")\n",
    "\n",
    "        print_rank_0(f\"Image tensor shape: {image_tensor.shape}\")\n",
    "        return image_tensor, image_grid_thw, raw_image\n",
    "\n",
    "    except Exception as e:\n",
    "        print(f\"⚠️ 이미지 처리 실패: {e}\")\n",
    "        traceback.print_exc()\n",
    "        raise e\n",
    "    \n",
    "image_tensor, image_grid_thw, raw_image = image_process(TEST_IMAGE_PATH, image_processor, args)"
   ]
  },
