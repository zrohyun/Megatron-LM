   "source": [
    "\"\"\"\n",
    "cell 7: 실제 추론 테스트 \n",
    "\"\"\"\n",
    "image_path = \"/workspace/Megatron-LM/test_images/mario.jpg\"\n",
    "image_tensor, image_grid_thw, raw_image = image_process(image_path, image_processor, args)\n",
    "image_pad = (\"<|image_pad|>\"*486) # 486은 이미지에 따라 다름 \n",
    "prompt = f\"\\n<|role_start|>user<|role_end|>{image_pad}\\n이 이미지에 대해서 설명해 주세요.\\n<|role_start|>assistant<|role_end|>\\n\"\n",
    "# input_text = tokenizer(prompt)\n",
    "# raw_image\n",
    "print_rank_0(\"Starting inference with VLMForwardStep...\")\n",
    "with torch.no_grad():\n",
    "    # generate_and_post_process는 토큰화된 리스트가 아닌 'Raw Text List'를 받음, 내부에서 tokenizer를 사용해 토큰화    # \n",
    "    response = generate_and_post_process(\n",
    "        model,\n",
    "        inference_context=inference_context,\n",
    "        forward_step=lambda model, context: VLMForwardStep(\n",
    "            images=image_tensor,\n",
    "            image_grid_thw=image_grid_thw,\n",
    "            model=model,    \n",
    "            max_batch_size=1,        # 프롬프트 1개\n",
    "            max_sequence_length=args.inference_max_seq_length,\n",
    "            inference_context=inference_context\n",
    "        ), # 위에서 만든 커스텀 forward 함수\n",
    "        prompts=[prompt],               \n",
    "        tokens_to_generate=128,         \n",
    "        \n",
    "        top_k_sampling=1,\n",
    "        temperature=0.1,                \n",
    "        add_BOS=False                   \n",
    "    )\n",
    "\n",
    "# ==========================================\n",
    "# 5. 결과 출력\n",
    "# ==========================================\n",
    "if torch.distributed.get_rank() == 0:\n",
    "    print(\"\\n\" + \"=\"*30)\n",
    "    if isinstance(response, (list, tuple)):\n",
    "        # 보통 (token_ids, text_str) 튜플 형태 또는 리스트\n",
    "        print(f\"🤖 Output: {response}\") \n",
    "    else:\n",
    "        print(f\"🤖 Output: {response}\")\n",
    "    print(\"=\"*30 + \"\\n\")"
   ]
  }
 ],
