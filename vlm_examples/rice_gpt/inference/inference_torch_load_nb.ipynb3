   "source": [
    "\"\"\"\n",
    "cell 4: 모델 checkpoint loading 빠른 로딩 \n",
    "load_checkpoint는 12분 걸림.. -> 현재 코드는 직접 호출로 2분 50초 컷\n",
    "\"\"\"\n",
    "import os\n",
    "import torch\n",
    "import torch.distributed.checkpoint as dist_cp\n",
    "from torch.distributed.checkpoint import FileSystemReader\n",
    "import logging\n",
    "# Megatron RNG 관련 경고 끄기\n",
    "logging.getLogger(\"megatron.core.tensor_parallel.random\").setLevel(logging.ERROR)\n",
    "\n",
    "from megatron.training import get_model, get_tokenizer, print_rank_0\n",
    "\n",
    "def load_checkpoint_lightweight_dcp(model, load_dir):\n",
    "    \"\"\"\n",
    "    Torch Distributed Checkpoint (DCP) 포맷을 위한 경량 로더.    \n",
    "    \"\"\"\n",
    "    \n",
    "    # 1. 체크포인트 경로 찾기 (iter_XXXXXXX 폴더 찾기)\n",
    "    # latest_checkpointed_iteration.txt가 있다면 사용, 없다면 load_dir 자체를 시도\n",
    "    tracker_filename = os.path.join(load_dir, 'latest_checkpointed_iteration.txt')\n",
    "    \n",
    "    if os.path.isfile(tracker_filename):\n",
    "        with open(tracker_filename, 'r') as f:\n",
    "            iteration = int(f.read().strip().split()[0])\n",
    "        checkpoint_path = os.path.join(load_dir, f\"iter_{iteration:07d}\")\n",
    "    else:\n",
    "        # 파일이 없으면 사용자가 지정한 폴더가 이미 체크포인트 폴더(iter_...)라고 가정\n",
    "        print(f\"Rank {torch.distributed.get_rank()}: Tracker file not found. Assuming load_dir is the checkpoint path.\")\n",
    "        checkpoint_path = load_dir\n",
    "        iteration = 0    \n",
    "\n",
    "    # 2. 모델 객체 준비 (List unwrapping & Module accessing)    \n",
    "    target_model = model[0] if isinstance(model, list) else model\n",
    "    if hasattr(target_model, 'module'):\n",
    "        target_model = target_model.module\n",
    "    \n",
    "    print(f\"Rank {torch.distributed.get_rank()}: Reading metadata from {checkpoint_path} ...\")\n",
    "    \n",
    "    # 3. 메타데이터 미리 읽기 (Checkpoint에 어떤 키가 있는지 확인)\n",
    "    try:\n",
    "        reader = FileSystemReader(checkpoint_path)\n",
    "        metadata = reader.read_metadata()\n",
    "        # 체크포인트 파일 안에 저장된 모든 키(Key)들의 집합\n",
    "        ckpt_keys = set(metadata.state_dict_metadata.keys())\n",
    "    except Exception as e:\n",
    "        print(f\"ERROR reading metadata: {e}\")\n",
    "        return 0\n",
    "    \n",
    "    # 4. 로드할 state dict 필터링  (strict=false)\n",
    "    local_state_dict = target_model.state_dict()\n",
    "    filtered_state_dict = {}    \n",
    "    missing_in_ckpt = []    \n",
    "    for key, value in local_state_dict.items():        \n",
    "        # 실제 체크포인트 키(Full Path)와 비교할 때는 \"model.\"을 붙여서 확인\n",
    "        expected_ckpt_key = f\"model.{key}\"\n",
    "        \n",
    "        if expected_ckpt_key in ckpt_keys:\n",
    "            filtered_state_dict[key] = value\n",
    "        else:\n",
    "            # 체크포인트에 없는 키는 로드 대상에서 제외\n",
    "            missing_in_ckpt.append(key)\n",
    "    \n",
    "    # 5. 필터링된 Dict로 로드 구조 생성\n",
    "    # 이제 존재하는 키만 들어있으므로 에러가 나지 않습니다.\n",
    "    state_dict_to_load = {\"model\": filtered_state_dict}\n",
    "\n",
    "    print(f\"Rank {torch.distributed.get_rank()}: Loading {len(filtered_state_dict)} tensors (Skipped {len(missing_in_ckpt)} missing keys)...\")\n",
    "    \n",
    "    if len(missing_in_ckpt) > 0 and torch.distributed.get_rank() == 0:\n",
    "         print(f\"  [Warning] First few missing keys: {missing_in_ckpt[:5]}\")\n",
    "\n",
    "    # 6. DCP 로드 실행\n",
    "    try:\n",
    "        dist_cp.load(\n",
    "            state_dict=state_dict_to_load,\n",
    "            checkpoint_id=checkpoint_path,\n",
    "            no_dist=False\n",
    "        )\n",
    "    except Exception as e:\n",
    "        print(f\"ERROR loading DCP checkpoint: {e}\")\n",
    "        return 0\n",
    "\n",
    "    # 7. (선택) 모델 버퍼나 파라미터가 제대로 들어갔는지 확인 (이미 In-place로 들어감)\n",
    "    # 별도 load_state_dict 호출 불필요 (dist_cp.load가 직접 메모리에 씀)\n",
    "\n",
    "    print(f\"Rank {torch.distributed.get_rank()}: DCP Load Complete.\")\n",
    "    return iteration\n",
    "    \n",
    "\n",
    "model = get_model(model_provider, wrap_with_ddp=False)\n",
    "\n",
    "load_dir = args.load\n",
    "load_checkpoint_lightweight_dcp(model, load_dir)\n",
    "# load_checkpoint(model, None, None, strict=False)\n",
    "\n",
    "if isinstance(model, list):\n",
    "    model = model[0]\n",
    "    \n",
    "# 모델을 추론용으로 스위치 \n",
    "model.eval()"
   ]
  },
