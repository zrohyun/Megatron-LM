       "              (linear_qkv): TELayerNormColumnParallelLinear(in_features=1024, out_features=3072, bias=True, TP=1)\n",
       "            )\n",
       "            (pre_cross_attn_layernorm): IdentityOp()\n",
       "            (cross_attention): IdentityOp()\n",
       "            (cross_attn_bda): IdentityFuncOp()\n",
       "            (pre_mlp_layernorm): IdentityOp()\n",
       "            (mlp): MLP(\n",
       "              (linear_fc1): TELayerNormColumnParallelLinear(in_features=1024, out_features=4096, bias=True, TP=1)\n",
       "              (linear_fc2): TERowParallelLinear(in_features=4096, out_features=1024, bias=True, TP=1)\n",
       "            )\n",
       "            (post_mlp_layernorm): IdentityOp()\n",
       "          )\n",
       "        )\n",
       "      )\n",
       "      (pre_layernorm): LayerNorm((1024,), eps=0.0001, elementwise_affine=True)\n",
       "    )\n",
       "    (vision_projection): VisionProjector(\n",
       "      (layernorm): LayerNorm()\n",
       "      (linear_fc1): TELinear()\n",
       "      (linear_fc2): TELinear()\n",
       "    )\n",
       "    (language_model): GPTModel(\n",
       "      (embedding): LanguageModelEmbedding(\n",
       "        (word_embeddings): VocabParallelEmbedding()\n",
       "        (embedding_dropout): Dropout(p=0.0, inplace=False)\n",
       "      )\n",
       "      (decoder): TransformerBlock(\n",
       "        (layers): ModuleList(\n",
       "          (0): TransformerLayer(\n",
       "            (input_layernorm): RMSNorm()\n",
       "            (self_attention): LocalGlobalMLASelfAttention(\n",
       "              (core_attention): TEDotProductAttentionSwitchingLocalGlobal(\n",
       "                (flash_attention): FlashAttention()\n",
       "                (fused_attention): FusedAttention()\n",
       "                (unfused_attention): UnfusedDotProductAttention(\n",
       "                  (scale_mask_softmax): FusedScaleMaskSoftmax()\n",
       "                  (attention_dropout): Dropout(p=0.0, inplace=False)\n",
       "                )\n",
       "              )\n",
       "              (linear_proj): TERowParallelLinear(in_features=1536, out_features=1536, bias=False, TP=1)\n",
       "              (post_attn_layernorm): RMSNorm()\n",
       "              (rotary_pos_emb): LocalGlobalRotaryEmbedding(\n",
       "                (rope_local): RotaryEmbedding()\n",
       "              )\n",
       "              (linear_q_down_proj): TELinear()\n",
       "              (linear_q_up_proj): TELayerNormColumnParallelLinear(in_features=768, out_features=2304, bias=False, TP=1)\n",
       "              (linear_kv_down_proj): TELinear()\n",
       "              (linear_kv_up_proj): TELayerNormColumnParallelLinear(in_features=512, out_features=3072, bias=False, TP=1)\n",
       "              (q_layernorm): IdentityOp()\n",
       "              (kv_layernorm): IdentityOp()\n",
       "            )\n",
       "            (pre_cross_attn_layernorm): IdentityOp()\n",
       "            (cross_attention): IdentityOp()\n",
       "            (cross_attn_bda): IdentityFuncOp()\n",
       "            (pre_mlp_layernorm): IdentityOp()\n",
       "            (mlp): MLP(\n",
       "              (linear_fc1): TELayerNormColumnParallelLinear(in_features=1536, out_features=11520, bias=False, TP=1)\n",
       "              (linear_fc2): TERowParallelLinear(in_features=5760, out_features=1536, bias=False, TP=1)\n",
       "            )\n",
       "            (post_mlp_layernorm): RMSNorm()\n",
       "          )\n",
       "          (1-23): 23 x TransformerLayer(\n",
       "            (input_layernorm): RMSNorm()\n",
       "            (self_attention): LocalGlobalMLASelfAttention(\n",
       "              (core_attention): TEDotProductAttentionSwitchingLocalGlobal(\n",
       "                (flash_attention): FlashAttention()\n",
       "                (fused_attention): FusedAttention()\n",
       "                (unfused_attention): UnfusedDotProductAttention(\n",
       "                  (scale_mask_softmax): FusedScaleMaskSoftmax()\n",
       "                  (attention_dropout): Dropout(p=0.0, inplace=False)\n",
       "                )\n",
       "              )\n",
       "              (linear_proj): TERowParallelLinear(in_features=1536, out_features=1536, bias=False, TP=1)\n",
       "              (post_attn_layernorm): RMSNorm()\n",
       "              (rotary_pos_emb): LocalGlobalRotaryEmbedding(\n",
       "                (rope_local): RotaryEmbedding()\n",
       "              )\n",
       "              (linear_q_down_proj): TELinear()\n",
       "              (linear_q_up_proj): TELayerNormColumnParallelLinear(in_features=768, out_features=2304, bias=False, TP=1)\n",
       "              (linear_kv_down_proj): TELinear()\n",
       "              (linear_kv_up_proj): TELayerNormColumnParallelLinear(in_features=512, out_features=3072, bias=False, TP=1)\n",
       "              (q_layernorm): IdentityOp()\n",
       "              (kv_layernorm): IdentityOp()\n",
       "            )\n",
       "            (pre_cross_attn_layernorm): IdentityOp()\n",
       "            (cross_attention): IdentityOp()\n",
       "            (cross_attn_bda): IdentityFuncOp()\n",
       "            (pre_mlp_layernorm): RMSNorm()\n",
       "            (mlp): MoELayer(\n",
       "              (router): TopKRouter()\n",
       "              (experts): TEGroupedMLP(\n",
       "                (linear_fc1): TEColumnParallelGroupedLinear()\n",
       "                (linear_fc2): TERowParallelGroupedLinear()\n",
       "              )\n",
       "              (shared_experts): SharedExpertMLP(\n",
       "                (linear_fc1): TEColumnParallelLinear(in_features=1536, out_features=1920, bias=False, TP=1)\n",
       "                (linear_fc2): TERowParallelLinear(in_features=960, out_features=1536, bias=False, TP=1)\n",
       "              )\n",
       "            )\n",
       "            (post_mlp_layernorm): RMSNorm()\n",
       "          )\n",
       "        )\n",
       "        (final_layernorm): RMSNorm()\n",
       "      )\n",
       "      (output_layer): ColumnParallelLinear(in_features=1536, out_features=137216, bias=False, TP=1)\n",
       "    )\n",
       "  )\n",
       ")"
      ]
     },
